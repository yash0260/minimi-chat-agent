# Required — get yours at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Required for Vercel deployment — get at https://turso.tech (free)
# For local dev, leave unset to use a local SQLite file automatically
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Optional — enables web search for fact verification (https://tavily.com)
TAVILY_API_KEY=your-tavily-api-key

# Optional overrides
# MODEL=gemini-2.0-flash
# PORT=3000
